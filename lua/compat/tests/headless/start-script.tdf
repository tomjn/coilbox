[game]
{
	ishost=1;
	FixedRNGSeed=1;
	numallyteams=2;
	numusers=3;
	numteams=2;
	numplayers=1;
	startpostype=0;
	gametype=@GAME@;
	mapname=@MAP@;
	myplayername=proof;
	[modoptions]
	{
		// The engine's own highest speed (GAME\ModOptions\MaxSpeed in
		// rts/Game/GameSetup.cpp), as the lowest too, so the match runs as fast
		// as the machine allows.
		minspeed=20;
		maxspeed=20;
		coilbox_proof_frames=@FRAMES@;
	}
	[player0]
	{
		spectator=1;
		name=proof;
		team=0;
	}
	[ai0]
	{
		name=AI0;
		shortname=NullAI;
		team=0;
		host=0;
	}
	[ai1]
	{
		name=AI1;
		shortname=NullAI;
		team=1;
		host=0;
	}
	[team0]
	{
		allyteam=0;
		teamleader=0;
		rgbcolor=1 0 0;
	}
	[team1]
	{
		allyteam=1;
		teamleader=0;
		rgbcolor=0 0 1;
	}
	[allyteam0]
	{
		numallies=0;
	}
	[allyteam1]
	{
		numallies=0;
	}
}
