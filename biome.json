{
  "$schema": "https://biomejs.dev/schemas/2.5.1/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!.claude",
      "!src-tauri",
      "!crates",
      "!**/*.css",
      "!catalog.json",
      "!scripts/data",
      "!src/dev/tauri-mcp-bridge.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "sonner": {
                "importNames": ["toast"],
                "message": "Import notify() from @/notify/notify instead, so the message reaches the notifications bell (issue #2429). A deliberately raw toast (an instant confirmation, or one using a sonner feature notify() can't express) needs a per-file override in biome.json."
              }
            }
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["docs/.vitepress/**/*.vue"],
      "linter": {
        "rules": {
          "correctness": {
            "useHookAtTopLevel": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/notify/notify.ts",
        "src/deeplink/copyLink.ts",
        "src/scenario/pages/components/deleteNotice.ts",
        "src/settings-storage.dom.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
