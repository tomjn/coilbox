node_modules
dist
.DS_Store

# Rust / Tauri (workspace target lives at the repo root)
/target
src-tauri/target

# mapconv sidecars are fetched from SpringMapConvNG releases at build time
# (see scripts/fetch-mapconv.sh + .github/workflows/release.yml), not committed.
# Bundled as a Tauri resource folder (binaries + their libs/).
src-tauri/mapconv/

# pr-downloader is bundled as a Tauri resource folder too (binary beside its
# Windows DLLs), assembled per-platform from the committed prebuilts by
# scripts/assemble-prdownloader.sh. The assembled folder is a build artifact; the
# sources (src-tauri/binaries/pr-downloader-*) stay committed.
src-tauri/prdownloader/

# The unitsync worker is our own workspace crate, built as an externalBin sidecar
# (scripts/build-unitsync-worker.sh locally, release.yml per-platform in CI).
# It's a build artifact, not a committed prebuilt like pr-downloader/uberstress.
src-tauri/binaries/coilbox-unitsync-worker-*

# Design mockups are throwaway prototypes; not shipped and not linted (biome
# honours this ignore file via useIgnoreFile).
docs/mockups/

# VitePress docs-site build artifacts (the site itself lives in docs/, its output
# and dev cache do not). `dist` above already covers docs/.vitepress/dist.
docs/.vitepress/cache/
