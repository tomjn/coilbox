node_modules
dist
.DS_Store

# Rust / Tauri (workspace target lives at the repo root)
/target
src-tauri/target

# mapconv sidecars are fetched from SpringMapConvNG releases at build time
# (see scripts/fetch-mapconv.sh + .github/workflows/release.yml), not committed.
# Bundled as a Tauri resource folder (binaries + their libs/).
src-tauri/mapconv/

# pr-downloader is bundled as a Tauri resource folder too (binary beside its
# Windows DLLs), assembled per-platform from the committed prebuilts by
# scripts/assemble-prdownloader.sh. The assembled folder is a build artifact; the
# sources (src-tauri/binaries/pr-downloader-*) stay committed.
src-tauri/prdownloader/

# The unitsync worker is our own workspace crate, built as an externalBin sidecar
# (scripts/build-unitsync-worker.sh locally, release.yml per-platform in CI).
# It's a build artifact, not a committed prebuilt like pr-downloader/uberstress.
src-tauri/binaries/coilbox-unitsync-worker-*

# The relay agent is the same story (scripts/build-relay-agent.sh).
src-tauri/binaries/coilbox-relay-agent-*

# Design mockups are throwaway prototypes; not shipped and not linted (biome
# honours this ignore file via useIgnoreFile).
docs/mockups/

# Reports agents write while investigating something. They are a snapshot of one
# run, so they go stale the moment the code moves and there is nothing to review
# in them. Kept out of the repo root so `git status` stays readable.
docs/reports/

# Working notes from the orchestrate-milestone skill, one file per milestone.
# None of them belong in the repo: they are a running log for one orchestration
# run, not documentation. Root-anchored so a real doc named this elsewhere still
# shows up.
/ORCHESTRATION-*.md

# VitePress docs-site build artifacts (the site itself lives in docs/, its output
# and dev cache do not). `dist` above already covers docs/.vitepress/dist.
docs/.vitepress/cache/

# Brainstorming mockups served by the superpowers visual companion.
.superpowers/

# Full logs from `bun run check` (scripts/check.sh), which mirrors the checks
# CI runs. Written here instead of a path an agent invents at the filesystem
# root.
check-output/

# Tauri rewrites each plugin's ACL from the COMMANDS list in its build.rs on
# every build, then merges all sixteen of them into src-tauri/gen/schemas. While
# that output was tracked, any PR adding a command left the tree permanently
# dirty until someone remembered to commit the regenerated files, which was
# missed six times and blocked pulls and branch switches. Everything a reviewer
# needs is still committed: each plugin's build.rs, its permissions/default.toml,
# and src-tauri/capabilities.
crates/*/permissions/autogenerated/
crates/*/permissions/schemas/
src-tauri/gen/schemas/
