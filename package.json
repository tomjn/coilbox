{
  "name": "coilbox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "heal:perm-cache": "bun scripts/heal-perm-cache.mjs",
    "sidecar:unitsync": "bash scripts/build-unitsync-worker.sh",
    "sidecar:prdownloader": "bash scripts/assemble-prdownloader.sh",
    "sidecar:relay-agent": "bash scripts/build-relay-agent.sh",
    "sidecar:all": "bun run sidecar:unitsync && bun run sidecar:prdownloader && bun run sidecar:relay-agent",
    "icon:macos-glass": "bash scripts/build-macos-glass-icon.sh",
    "stars:catalogue": "bun scripts/build-star-catalogue.mjs && biome check --write src/conquest/realstars/catalogue.json",
    "keybinds:defaults": "bun scripts/build-engine-keybinds.mjs && biome check --write src/content/engineKeybinds.generated.ts",
    "lego:pack": "bun scripts/legopack/build.mjs",
    "lego:reads3o": "bun scripts/reads3o.mjs",
    "lego:reference": "bun scripts/reference-model.mjs",
    "clean": "bash scripts/clean.sh",
    "check": "bash scripts/check.sh",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:thumbs": "bash scripts/docs-thumbs.sh",
    "lint": "biome check .",
    "test": "vitest run",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/oxanium": "^5.3.0",
    "@picoframe/frame": "^0.8.0",
    "@picoframe/plugin-sdk": "^0.8.0",
    "@shadcn/react": "^0.2.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-deep-link": "2.4.9",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "@xyflow/react": "^12.11.6",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "emojibase": "^17.0.0",
    "emojibase-data": "^17.0.0",
    "fflate": "^0.8.3",
    "flag-icons": "^7.5.0",
    "lucide-react": "^1.41.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.3",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11"
  }
}
