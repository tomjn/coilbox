{
  "name": "coilbox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "heal:perm-cache": "bun scripts/heal-perm-cache.mjs",
    "sidecar:unitsync": "bash scripts/build-unitsync-worker.sh",
    "sidecar:prdownloader": "bash scripts/assemble-prdownloader.sh",
    "sidecar:all": "bun run sidecar:unitsync && bun run sidecar:prdownloader",
    "icon:macos-glass": "bash scripts/build-macos-glass-icon.sh",
    "stars:catalogue": "bun scripts/build-star-catalogue.mjs && biome check --write src/conquest/realstars/catalogue.json",
    "lego:pack": "bun scripts/legopack/build.mjs",
    "lego:reads3o": "bun scripts/reads3o.mjs",
    "lego:reference": "bun scripts/reference-model.mjs",
    "clean": "bash scripts/clean.sh",
    "check": "bash scripts/check.sh",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "biome check .",
    "test": "vitest run",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/oxanium": "^5.3.0",
    "@picoframe/frame": "^0.6.0",
    "@picoframe/plugin-sdk": "^0.6.0",
    "@shadcn/react": "^0.2.1",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-deep-link": "2.4.9",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xyflow/react": "^12.11.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "emojibase": "^17.0.0",
    "emojibase-data": "^17.0.0",
    "fflate": "^0.8.3",
    "flag-icons": "^7.5.0",
    "lucide-react": "^1.21.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-router": "^7.6.3",
    "recharts": "^3.9.0",
    "shiki": "^4.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.9"
  }
}
