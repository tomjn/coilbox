// Shapes the decompiler has to rebuild exactly. It is compiled, decompiled and
// compiled again, and both compiles must give the same bytes.
#define SIG_AIM 2

piece base, torso, flare, gun;

static-var restore, count, flags;

Create()
{
	restore = 0;
	count = -5;
	flags = count - (restore - 1);
	flags = (count + 1) * (restore - 2);
	flags = count - -3;
	flags = !(count < restore) && flags || count ^^ restore;
	flags = count * restore / (count % 3);
	flags = count & 1 | restore ^ 2;
	flags = get 3(flare, 0, 1);
	flags = get 3(flare, 0, 0, 7);
	flags = get (count + 1);
	start-script Walk();
}

Walk()
{
	var step;
	scale torso to x-axis [2] speed [0.5];
	scale gun to y-axis [1.5] now;
	wait-for-scale torso along x-axis;
	while (count < 10)
	{
		if (step == 0)
		{
			move torso to y-axis [2.5] speed [1];
			step = 1;
		}
		else
		{
			if (step == 1)
			{
				move torso to y-axis [-1.25] now;
			}
			step = 0;
		}
		++count;
		sleep 100;
	}
	if (count > 3)
	{
		while (count > 0)
		{
			--count;
		}
	}
	if (count)
	{
		if (restore)
		{
			hide gun;
		}
		else
		{
		}
	}
}

AimWeapon1(heading, pitch)
{
	signal SIG_AIM;
	set-signal-mask SIG_AIM;
	turn torso to y-axis heading speed <225.5>;
	turn gun to x-axis 0 - pitch speed <-45>;
	turn flare to z-axis <30> now;
	spin gun around z-axis speed <-600> accelerate <3>;
	stop-spin gun around z-axis decelerate <7>;
	wait-for-turn torso around y-axis;
	call-script Restore(heading, pitch + 1);
	return (1);
}

Restore(a, b)
{
	var later;
	later = a + b;
	sleep later;
	turn torso to y-axis 0 speed <90>;
	if (a > b)
	{
		return (0);
	}
}

QueryWeapon1(piecenum)
{
	piecenum = flare;
}

AimFromWeapon1(piecenum)
{
	piecenum = torso;
}

FireWeapon1()
{
	emit-sfx 1024 + 1 from flare;
	explode torso type 3 | 4;
	show flare;
	sleep 50;
	hide flare;
	set 1 to count;
	attach-unit count to 2;
	drop-unit count;
}

Killed(severity, corpsetype)
{
	if (severity <= 25)
	{
		corpsetype = 1;
		return (0);
	}
	corpsetype = 2;
	return (0);
}
